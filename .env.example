DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
# Wygeneruj: openssl rand -hex 32 (min. 32 znaki, backend nie wystartuje bez tego)
JWT_SECRET=

POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# Adres frontendu (linki w e-mailach) i dozwolone originy CORS (po przecinku)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Adres API widziany z przeglądarki
VITE_API_URL=http://localhost:8000
# W produkcji za HTTPS ustaw true
COOKIE_SECURE=false

# SMTP — puste SMTP_HOST = tryb dev: treść e-maili (z linkami) trafia do logów backendu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FinManager <no-reply@finmanager.app>
